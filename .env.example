# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env. Hanya .env.example yang boleh masuk repo.

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=sentiment_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dipakai SQLAlchemy / Alembic di backend
DATABASE_URL=postgresql+psycopg://sentiment:ganti_dengan_password_kuat@localhost:5432/sentiment_db

# ---------- Backend (FastAPI) ----------
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000

# Batas upload CSV
MAX_UPLOAD_MB=10
MAX_TEXT_LENGTH=1000

# ---------- Model ----------
# Lokasi file model hasil training (tidak di-commit)
BASELINE_MODEL_PATH=ml/artifacts/tfidf_svm.joblib
# Model IndoBERT: path lokal atau ID repo di Hugging Face Hub
INDOBERT_MODEL_PATH=ml/artifacts/indobert
# Model default untuk endpoint /predict: tfidf_svm atau indobert
DEFAULT_MODEL=tfidf_svm

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Opsional ----------
# Token Hugging Face, hanya jika mengunduh/mengunggah model privat
HF_TOKEN=
