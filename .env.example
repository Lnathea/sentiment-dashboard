# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env. Hanya .env.example yang boleh masuk repo.

# ---------- Database ----------
# Dev lokal memakai SQLite (tanpa Docker). Path relatif dihitung dari folder
# tempat backend/alembic dijalankan (backend/), jadi file ada di backend/sentiment.sqlite3.
# Untuk deploy nanti bisa diganti PostgreSQL, mis.:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME  (perlu pip install psycopg)
DATABASE_URL=sqlite:///./sentiment.sqlite3

# ---------- Backend (FastAPI) ----------
# Host/port server diatur lewat argumen uvicorn (default 127.0.0.1:8000),
# bukan lewat .env.
APP_ENV=development
# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000

# Batas upload CSV
MAX_UPLOAD_MB=10
MAX_TEXT_LENGTH=1000

# ---------- Model ----------
# Lokasi file model hasil training (tidak di-commit). Path relatif dihitung dari root repo.
BASELINE_MODEL_PATH=ml/artifacts/tfidf_svm.joblib
# Model default untuk endpoint /predict. Saat ini hanya tfidf_svm yang tersedia.
DEFAULT_MODEL=tfidf_svm
# [Fase 2, belum dibaca backend] Model IndoBERT: path lokal atau ID repo Hugging Face Hub
INDOBERT_MODEL_PATH=ml/artifacts/indobert

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Opsional ----------
# [Fase 2] Token Hugging Face, hanya jika mengunduh/mengunggah model privat
HF_TOKEN=
